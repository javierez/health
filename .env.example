# Postgres. Supabase gives you this under Project settings → Database.
DATABASE_URL=postgresql://...

# app.heypocket.com → Settings → API keys. Personal key, starts with pk_
POCKET_API_KEY=pk_...

ANTHROPIC_API_KEY=sk-ant-...

# Any long random string. Guards /api/sync and lives in the webhook URL:
#   https://<host>/api/webhooks/pocket/<SYNC_SECRET>
SYNC_SECRET=
